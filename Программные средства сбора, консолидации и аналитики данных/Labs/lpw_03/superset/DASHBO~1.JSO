      "position_json": "{\"DASHBOARD_VERSION_KEY\": \"v2\", \"ROOT_ID\": {\"id\": \"ROOT_ID\", \"type\": \"ROOT\", \"children\": [\"GRID_ID\"]}, \"GRID_ID\": {\"id\": \"GRID_ID\", \"type\": \"GRID\", \"children\": [\"NOTE\", \"ROW1\", \"ROW2\", \"ROW3\"], \"parents\": [\"ROOT_ID\"]}, \"NOTE\": {\"id\": \"NOTE\", \"type\": \"MARKDOWN\", \"children\": [], \"parents\": [\"ROOT_ID\", \"GRID_ID\"], \"meta\": {\"width\": 12, \"height\": 16, \"code\": \"### World Happiness Report, 2015–2019\\nФильтры «Год» и «Регион» действуют на все графики. Без фильтра года топ-10 использует средний балл за доступные годы. Круговая диаграмма считает уникальные страны. ВВП показан как вклад в балл счастья. Unknown — Гамбия (2019).\"}}, \"ROW1\": {\"id\": \"ROW1\", \"type\": \"ROW\", \"children\": [\"CHART-1\", \"CHART-2\", \"CHART-3\"], \"parents\": [\"ROOT_ID\", \"GRID_ID\"], \"meta\": {\"background\": \"BACKGROUND_TRANSPARENT\"}}, \"CHART-1\": {\"id\": \"CHART-1\", \"type\": \"CHART\", \"children\": [], \"parents\": [\"ROOT_ID\", \"GRID_ID\", \"ROW1\"], \"meta\": {\"chartId\": 1, \"sliceName\": \"Средний балл счастья (0–10)\", \"width\": 3, \"height\": 55}}, \"CHART-2\": {\"id\": \"CHART-2\", \"type\": \"CHART\", \"children\": [], \"parents\": [\"ROOT_ID\", \"GRID_ID\", \"ROW1\"], \"meta\": {\"chartId\": 2, \"sliceName\": \"Топ-10 стран по среднему баллу счастья\", \"width\": 5, \"height\": 55}}, \"CHART-3\": {\"id\": \"CHART-3\", \"type\": \"CHART\", \"children\": [], \"parents\": [\"ROOT_ID\", \"GRID_ID\", \"ROW1\"], \"meta\": {\"chartId\": 3, \"sliceName\": \"Распределение стран по регионам\", \"width\": 4, \"height\": 55}}, \"ROW2\": {\"id\": \"ROW2\", \"type\": \"ROW\", \"children\": [\"CHART-4\"], \"parents\": [\"ROOT_ID\", \"GRID_ID\"], \"meta\": {\"background\": \"BACKGROUND_TRANSPARENT\"}}, \"CHART-4\": {\"id\": \"CHART-4\", \"type\": \"CHART\", \"children\": [], \"parents\": [\"ROOT_ID\", \"GRID_ID\", \"ROW2\"], \"meta\": {\"chartId\": 4, \"sliceName\": \"Вклад ВВП и балл счас