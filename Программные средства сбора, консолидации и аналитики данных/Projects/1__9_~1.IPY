"</div>\n","    <div class=\"colab-df-buttons\">\n","\n","  <div class=\"colab-df-container\">\n","    <button class=\"colab-df-convert\" onclick=\"convertToInteractive('df-c8d981cb-e3de-4f0a-8c15-704262cf55dc')\"\n","            title=\"Convert this dataframe to an interactive table.\"\n","            style=\"display:none;\">\n","\n","  <svg xmlns=\"http://www.w3.org/2000/svg\" height=\"24px\" viewBox=\"0 -960 960 960\">\n","    <path d=\"M120-120v-720h720v720H120Zm60-500h600v-160H180v160Zm220 220h160v-160H400v160Zm0 220h160v-160H400v160ZM180-400h160v-160H180v160Zm440 0h160v-160H620v160ZM180-180h160v-160H180v160Zm440 0h160v-160H620v160Z\"/>\n","  </svg>\n","    </button>\n","\n","  <style>\n","    .colab-df-container {\n","      display:flex;\n","      gap: 12px;\n","    }\n","\n","    .colab-df-convert {\n","      background-color: #E8F0FE;\n","      border: none;\n","      border-radius: 50%;\n","      cursor: pointer;\n","      display: none;\n","      fill: #1967D2;\n","      height: 32px;\n","      padding: 0 0 0 0;\n","      width: 32px;\n","    }\n","\n","    .colab-df-convert:hover {\n","      background-color: #E2EBFA;\n","      box-shadow: 0px 1px 2px rgba(60, 64, 67, 0.3), 0px 1px 3px 1px rgba(60, 64, 67, 0.15);\n","      fill: #174EA6;\n","    }\n","\n","    .colab-df-buttons div {\n","      margin-bottom: 4px;\n","    }\n","\n","    [theme=dark] .colab-df-convert {\n","      background-color: #3B4455;\n","      fill: #D2E3FC;\n","    }\n","\n","    [theme=dark] .colab-df-convert:hover {\n","      background-color: #434B5C;\n","      box-shadow: 0px 1px 3px 1px rgba(0, 0, 0, 0.15);\n","      filter: drop-shadow(0px 1px 2px rgba(0, 0, 0, 0.3));\n","      fill: #FFFFFF;\n","    }\n","  </style>\n","\n","    <script>\n","      const buttonEl =\n","        document.querySelector('#df-c8d981cb-e3de-4f0a-8c15-704262cf55dc button.colab-df-convert');\n","      buttonEl.style.display =\n","        google.colab.kernel.accessAllowed ? 'block' : 'none';\n","\n","      async function convertToInteractive(key) {\n","        const element = document.querySelector('#df-c8d981cb-e3de-4f0a-8c15-704262cf55dc');\n","        const dataTable =\n","          await google.colab.kernel.invokeFunction('convertToInteractive',\n","                                                    [key], {});\n","        if (!dataTable) return;\n","\n","        const docLinkHtml = 'Like what you see? Visit the ' +\n","          '<a target=\"_blank\" href=https://colab.research.google.com/notebooks/data_table.ipynb>data table notebook</a>'\n","          + ' to learn more about interactive tables.';\n","        element.innerHTML = '';\n","        dataTable['output_type'] = 'display_data';\n","        await google.colab.output.renderOutput(dataTable, element);\n","        const docLink = document.createElement('div');\n","        docLink.innerHTML = docLinkHtml;\n","        element.appendChild(docLink);\n","      }\n","    </script>\n","  </div>\n","\n","\n","    </div>\n","  </div>\n"],"application/vnd.google.colaboratory.intrinsic+json":{"type":"dataframe","summary":"{\n  \"name\": \"display(df_web\",\n  \"rows\": 10,\n  \"fields\": [\n    {\n      \"column\": \"\\u0442\\u0438\\u043f\",\n      \"properties\": {\n        \"dtype\": \"category\",\n        \"num_unique_values\": 3,\n        \"samples\": [\n          \"object\",\n          \"float64\",\n          \"Int64\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}}]},{"cell_type":"markdown","metadata":{"id":"O_DjRupeu7eX"},"source":["**Как читать вывод.** Сначала блок проверки регулярных выражений: пока он не показывает «все ок», данные трогать рано. Затем таблица качества очистки — доля распознанных значений по каждому источнику. Ориентир: не ниже 80 %. Если ниже, ищите формат, который выражение не покрывает (обычно это неразрывный пробел, диапазон «от … до …» или валюта, записанная словом). Помните: строки с нераспознанной ценой не исчезают — они превращаются в пропуски и молча уменьшают выборку."]},{"cell_type":"markdown","metadata":{"id":"x13i1I7lu7eX"},"source":["### Шаг 5. Разведочный анализ и визуализация\n","\n","**Зачем мы это делаем.** Метрика без распределения обманывает: среднее по ценам с одной дорогой позицией сместится, а «топ-10» без указания объёма выборки не значит ничего. Поэтому смотрим на распределения, медианы и квартили, а на графики выносим опорные линии и размер выборки.\n","\n","Тяжёлые агрегации делаем в `pandas`, а рисуем уже маленькие итоговые таблицы."]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"SWnJu5riu7eY","executionInfo":{"status":"ok","timestamp":1792004132922,"user_tz":-180,"elapsed":3221,"user":{"displayName":"Ivan Voyt","userId":"07579874121352092142"}},"outputId":"5b89a6d8-9e33-4df9-c671-be749817d22b"},"source":["#@title Шаг 5. Разведочный анализ и визуализация (задание) { display-mode: \"form\" }\n","# ------------------------------------------------------------------ TODO 5.1\n","# Постройте не менее четырёх графиков, указанных в вашем варианте (CFG[\"metrics\"]).\n","# Требования к каждому графику:\n","#   * осмысленный заголовок с указанием объёма выборки (n = ...);\n","#   * подписанные оси с единицами измерения;\n","#   * опорная линия там, где она помогает читать график (медиана, порог, среднее);\n","#   * современный API seaborn: sns.barplot(..., hue=..., legend=False), а не palette без hue.\n","# Данные агрегируйте в pandas, а рисуйте уже маленькие таблицы.\n","# todo(\"5.1\")\n","weights = pd.Series({\"USD\": 0.5, \"EUR\": 0.3, \"CNY\": 0.2})\n","rates = df_api.pivot(index=\"date\", columns=\"currency\", values=\"rate_rub\").sort_index()\n","# Используем только общие даты опубликованных курсов; не создаём фиктивные записи.\n","rates = rates[weights.index].dropna()\n","assert len(rates) >= 50\n","base_rates = rates.iloc[0]\n","normalized = rates.div(base_rates)\n","basket_index = normalized.mul(weights).sum(axis=1) * 100\n","drawdown = basket_index / basket_index.cummax() - 1\n","trough = drawdown.idxmin()\n","peak = basket_index.loc[:trough].idxmax()\n","mdd = float(drawdown.min())\n","last_rates = rates.iloc[-1]\n","last_date = rates.index[-1]\n","df_web[\"price_rub\"] = df_web[\"price\"] * last_rates[\"USD\"]\n","df_web[\"price_rub_base\"] = df_web[\"price\"] * base_rates[\"USD\"]\n","df_final = df_web.assign(fx_currency=\"USD\", fx_date=last_date, fx_rate=last_rates[\"USD\"])\n","returns = rates.pct_change().dropna()\n","currency_stats = pd.DataFrame({\"начальный курс, ₽\": base_rates,\n","    \"последний курс, ₽\": last_rates, \"изменение, %\": (last_rates / base_rates - 1) * 100,\n","    \"std дневных изменений, %\": returns.std() * 100})\n","display(currency_stats.round(4))\n","display(df_final[[\"title\", \"price\", \"price_rub\", \"fx_date\", \"rating\"]].head(10))\n","\n","fig, ax = plt.subplots(figsize=(11, 4))\n","for cur in rates:\n","    ax.plot(rates.index, rates[cur], label=cur)\n","ax.set(title=f\"Курсы ЦБ РФ: {len(rates)} общих дат, {len(df_api)} записей\",\n","       xlabel=\"Дата действия курса\", ylabel=\"Рубли за 1 единицу валюты\")\n","ax.legend(); fig.autofmt_xdate(); plt.tight_layout(); plt.show()\n","\n","fig, ax = plt.subplots(figsize=(11, 4))\n","for cur in normalized:\n","    ax.plot(normalized.index, normalized[cur] * 100, alpha=.45, label=cur)\n","ax.plot(basket_index.index, basket_index, color=\"black\", linewidth=2, label=\"Корзина 50/30/20\")\n","ax.axhline(100, ls=\"--\", color=\"grey\", label=\"База = 100\")\n","ax.set(title=f\"Индекс стоимости корзины, n={len(rates)} дат\",\n","       xlabel=\"Дата\", ylabel=\"Индекс, пунктов\")\n","ax.legend(); fig.autofmt_xdate(); plt.tight_layout(); plt.show()\n","\n","fig, ax = plt.subplots(figsize=(11, 4))\n","ax.fill_between(drawdown.index, drawdown * 100, 0, alpha=.4)\n","ax.axhline(mdd * 100, color=\"red\", ls=\"--\", label=f\"Максимум: {mdd:.2%}\")\n","ax.set(title=f\"Просадка стоимости корзины от предыдущего максимума, n={len(rates)}\",\n","       xlabel=\"Дата\", ylabel=\"Изменение от максимума, %\")\n","ax.legend(); fig.autofmt_xdate(); plt.tight_layout(); plt.show()\n","\n","fig, ax = plt.subplots(figsize=(10, 4))\n","sns.histplot(df_web, x=\"price_rub\", bins=15, ax=ax)\n","ax.axvline(df_web.price_rub.median(), color=\"red\", ls=\"--\", label=\"Медиана\")\n","ax.set(title=f\"Цены ноутбуков по USD ЦБ на {last_date.date()}, n={len(df_web)}\",\n","       xlabel=\"Расчётная цена, ₽\", ylabel=\"Число карточек, шт.\")\n","ax.legend(); plt.tight_layout(); plt.show()\n","\n"],"execution_count":24,"outputs":[{"output_type":"display_data","data":{"text/plain":["          начальный курс, ₽  последний курс, ₽  изменение, %  std дневных изменений, %\n","currency                                                                              \n","USD                 72.1388            83.8675       16.2585                    0.7723\n","EUR                 83.7315            93.7723       11.9917                    0.8184\n","CNY                 10.6624            12.5028       17.2607                    0.7849"],"text/html":["\n","  <div id=\"df-feb64eba-2db2-42c1-99d8-96aad771f32b\" class=\"colab-df-container\">\n","    <div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>начальный курс, ₽</th>\n","      <th>последний курс, ₽</th>\n","      <th>изменение, %</th>\n","      <th>std дневных изменений, %</th>\n","    </tr>\n","    <tr>\n","      <th>currency</th>\n","      <th></th>\n","      <th></th>\n","      <th></th>\n","      <th></th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>USD</th>\n","      <td>72.1388</td>\n","      <td>83.8675</td>\n","      <td>16.2585</td>\n","      <td>0.7723</td>\n","    </tr>\n","    <tr>\n","      <th>EUR</th>\n","      <td>83.7315</td>\n","      <td>93.7723</td>\n","      <td>11.9917</td>\n","      <td>0.8184</td>\n","    </tr>\n","    <tr>\n","      <th>CNY</th>\n","      <td>10.6624</td>\n","      <td>12.5028</td>\n","      <td>17.2607</td>\n","      <td>0.7849</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>\n","    <div class=\"colab-df-buttons\">\n","\n","  <div class=\"colab-df-container\">\n","    <button class=\"colab-df-convert\" onclick=\"convertToInteractive('df-feb64eba-2db2-42c1-99d8-96aad771f32b')\"\n","            title=\"Convert this dataframe to an interactive table.\"\n","            style=\"display:none;\">\n","\n","  <svg xmlns=\"http://www.w3.org/2000/svg\" height=\"24px\" viewBox=\"0 -960 960 960\">\n","    <path d=\"M120-120v-720h720v720H120Zm60-500h600v-160H180v160Zm220 220h160v-160H400v160Zm0 220h160v-160H400v160ZM180-400h160v-160H180v160Zm440 0h160v-160H620v160ZM180-180h160v-160H180v160Zm440 0h160v-160H620v160Z\"/>\n","  </svg>\n","    </button>\n","\n","  <style>\n","    .colab-df-container {\n","      display:flex;\n","      gap: 12px;\n","    }\n","\n","    .colab-df-convert {\n","      background-color: #E8F0FE;\n","      border: none;\n","      border-radius: 50%;\n","      cursor: pointer;\n","      display: none;\n","      fill: #1967D2;\n","      height: 32px;\n","      padding: 0 0 0 0;\n","      width: 32px;\n","    }\n","\n","    .colab-df-convert:hover {\n","      background-color: #E2EBFA;\n","      box-shadow: 0px 1px 2px rgba(60, 64, 67, 0.3), 0px 1px 3px 1px rgba(60, 64, 67, 0.15);\n","      fill: #174EA6;\n","    }\n","\n","    .colab-df-buttons div {\n","      margin-bottom: 4px;\n","    }\n","\n","    [theme=dark] .colab-df-convert {\n","      background-color: #3B4455;\n","      fill: #D2E3FC;\n","    }\n","\n","    [theme=dark] .cola